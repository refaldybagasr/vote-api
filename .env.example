# Dev-only placeholder values. Never commit a real .env file.

NODE_ENV=development
PORT=3000

# Single-node replica set started by docker-compose.yml.
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017/voting?directConnection=true

# Dev-only placeholder. In production this must be a strong random secret
# (32+ characters) — the app refuses to start otherwise.
JWT_ACCESS_SECRET=dev-only-placeholder-change-me-please-32chars
JWT_ISSUER=vote-api
JWT_AUDIENCE=vote-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Secure cookies require HTTPS; keep false for local HTTP development.
COOKIE_SECURE=false

FRONTEND_ORIGIN=http://localhost:5173

# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

BCRYPT_COST=10

DOCS_ENABLED=true
LOG_LEVEL=info

# Dev-only demo credentials, consumed by `npm run seed`.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=dev-only-admin-password
SEED_DEMO_USERS=demo1:dev-only-password,demo2:dev-only-password
